# Browser-safe values only; copy these into supabase-config.js for GitHub Pages.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_OR_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY

# Add this as a Supabase Edge Function secret. Never commit its real value.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
